//+------------------------------------------------------------------+
//|                                    PreviousHTFOpenClose.pine     |
//|                                                                  |
//|  Plots exactly 2 dotted lines: the OPEN and CLOSE of the single  |
//|  most recently completed 1H (or 4H) candle. Only the latest      |
//|  candle is considered - as soon as a new higher-timeframe        |
//|  candle closes, the old lines are deleted and replaced. Nothing  |
//|  from earlier candles is kept on the chart.                      |
//+------------------------------------------------------------------+
//@version=5
indicator("Previous HTF Open/Close", shorttitle="Prev HTF O/C", overlay=true, max_lines_count=2, max_labels_count=2)

tfInput    = input.timeframe("60", title="Higher Timeframe", options=["60", "240"])
openColor  = input.color(#2962FF, title="Open Line Color")
closeColor = input.color(#FF6D00, title="Close Line Color")
lineWidth  = input.int(1, title="Line Width", minval=1, maxval=4)
showLabels = input.bool(true, title="Show Price Labels")

// Open, close, and start time of the single previous (fully closed) HTF candle
[htfOpen, htfClose, htfTime] = request.security(syminfo.tickerid, tfInput, [open[1], close[1], time], lookahead=barmerge.lookahead_off)

var line  openLine  = na
var line  closeLine = na
var label openLbl   = na
var label closeLbl  = na

isNewHtfBar = htfTime != htfTime[1]

if isNewHtfBar
    // Wipe out the previous pair completely - only the latest candle's lines exist
    line.delete(openLine)
    line.delete(closeLine)
    label.delete(openLbl)
    label.delete(closeLbl)

    openLine  := line.new(bar_index, htfOpen, bar_index, htfOpen, extend=extend.right, color=openColor, style=line.style_dotted, width=lineWidth)
    closeLine := line.new(bar_index, htfClose, bar_index, htfClose, extend=extend.right, color=closeColor, style=line.style_dotted, width=lineWidth)

    if showLabels
        openLbl  := label.new(bar_index, htfOpen, "Prev Open " + str.tostring(htfOpen, format.mintick), style=label.style_label_left, textcolor=openColor, color=color.new(color.black, 100), size=size.small)
        closeLbl := label.new(bar_index, htfClose, "Prev Close " + str.tostring(htfClose, format.mintick), style=label.style_label_left, textcolor=closeColor, color=color.new(color.black, 100), size=size.small)
else if showLabels
    // Keep the labels pinned to the right edge so they stay readable
    if not na(openLbl)
        label.set_x(openLbl, bar_index)
    if not na(closeLbl)
        label.set_x(closeLbl, bar_index)
